/// Daily calendar 2019-2026, marked as the date table.
table dim_date
	lineageTag: 9ea2f80d-9b44-43ab-994d-44dab3a89b43
	dataCategory: Time

	column date_day
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 19ae7c28-5738-4ce1-87ca-3ccb52c038ae
		summarizeBy: none
		sourceColumn: date_day

	column year_number
		dataType: int64
		formatString: 0
		lineageTag: c4587b8c-18f4-4e03-997a-e32c37b109b1
		summarizeBy: none
		sourceColumn: year_number

	column quarter_name
		dataType: string
		lineageTag: 3fa800ef-997f-46ed-9993-39ef94d42d75
		summarizeBy: none
		sourceColumn: quarter_name

	column month_number
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b453935e-11dc-490e-8e12-a73e1f9a66af
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: cf30eae4-f3c8-4305-b78f-79e700868ae3
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: c944a230-2fdd-469a-b6c8-a9c17b316b9b
		summarizeBy: none
		sourceColumn: month_start

	column is_december
		dataType: boolean
		lineageTag: ceedef03-0eda-41d4-8b64-0bc9a440caac
		summarizeBy: none
		sourceColumn: is_december

	partition dim_date = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "dim_date.parquet" ) )
				in
					Source

