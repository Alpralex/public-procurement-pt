{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "kpi",
      "queryLines": [
        "SELECT count(*) AS contracts,\n       round(sum(contract_value_eur) / 1e9, 2) AS value_bn,\n       round(avg(CASE WHEN procedure_group = 'Open tender' AND bidders_count IS NOT NULL\n                      THEN CAST(is_single_bid AS INT) END) * 100, 1) AS open_single_bid_pct,\n       count(DISTINCT contracting_entity) AS buyers\nFROM workspace.gold.contracts_enriched"
      ]
    },
    {
      "name": "ds_year",
      "displayName": "year",
      "queryLines": [
        "SELECT contract_year, entity_type, procedure_group,\n       count(*) AS contracts, sum(contract_value_eur) / 1e9 AS value_bn\nFROM workspace.gold.contracts_enriched\nGROUP BY ALL"
      ]
    },
    {
      "name": "ds_category",
      "displayName": "category",
      "queryLines": [
        "SELECT cpv_category, count(*) AS contracts, sum(contract_value_eur) / 1e9 AS value_bn\nFROM workspace.gold.contracts_enriched\nGROUP BY ALL"
      ]
    },
    {
      "name": "ds_region",
      "displayName": "region",
      "queryLines": [
        "SELECT region, region_group, count(*) AS contracts, sum(contract_value_eur) / 1e9 AS value_bn\nFROM workspace.gold.contracts_enriched\nWHERE region_group NOT IN ('Multiple or national', 'Abroad', 'Not reported')\nGROUP BY ALL"
      ]
    },
    {
      "name": "ds_single_bid",
      "displayName": "single bid",
      "queryLines": [
        "SELECT contract_year, procedure_group,\n       round(sum(single_bid_contracts) / sum(contracts_with_bidders) * 100, 1) AS single_bid_pct\nFROM workspace.gold.mart_competition\nWHERE procedure_group IN ('Open tender', 'Prior consultation') AND contract_year <= 2025\nGROUP BY ALL"
      ]
    },
    {
      "name": "ds_bunching",
      "displayName": "bunching",
      "queryLines": [
        "SELECT bin_start / 1000 AS value_k_eur, sum(contracts) AS contracts\nFROM workspace.gold.mart_threshold_bunching\nWHERE threshold_family = 'Goods and services' AND bin_start BETWEEN 5000 AND 99000\nGROUP BY ALL"
      ]
    },
    {
      "name": "ds_thresholds",
      "displayName": "thresholds",
      "queryLines": [
        "SELECT procedure_limit || ' (' || threshold_family || ', EUR ' || format_number(threshold_eur, 0) || ')' AS legal_limit,\n       contracts_just_below, contracts_just_above,\n       round(contracts_just_below / neighbour_bin_avg, 1) AS times_neighbours\nFROM workspace.gold.mart_threshold_summary"
      ]
    },
    {
      "name": "ds_concentration",
      "displayName": "concentration",
      "queryLines": [
        "SELECT c.cpv_short_name AS category, round(m.hhi) AS hhi, round(m.top5_share * 100, 1) AS top5_pct,\n       m.supplier_value / 1e9 AS value_bn\nFROM workspace.gold.mart_supplier_concentration m\nJOIN workspace.gold.dim_cpv c USING (cpv_division)\nWHERE m.period = '2019-2026' AND m.supplier_value > 5e8"
      ]
    },
    {
      "name": "ds_price",
      "displayName": "price",
      "queryLines": [
        "SELECT procedure_group,\n       round((1 - sum(base_contract_value) / sum(base_price_total)) * 100, 1) AS pct_below_base_price\nFROM workspace.gold.mart_price_vs_base\nGROUP BY ALL\nHAVING sum(base_contracts) > 1000"
      ]
    }
  ],
